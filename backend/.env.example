# Copy this file to ".env" and fill in your real values.
# NEVER commit the real ".env" file to GitHub.

PORT=8000

# Get this from MongoDB Atlas -> Connect -> Drivers -> copy the connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/blood_response?retryWrites=true&w=majority

# Path to the Firebase service account JSON file (see serviceAccountKey.json.example)
FIREBASE_CRED_PATH=./serviceAccountKey.json
